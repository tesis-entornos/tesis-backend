# Copy to .env (never commit .env). Values below are for local development only.

# Enable development behavior (also exposes the /private routes used by E2E tests)
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Used for CORS and for links in emails
FRONTEND_HOST=http://localhost:5173

# Emails (Mailpit in local development)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Cache (Redis). Leave REDIS_URL empty to disable the cache.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=tesis

# File storage (S3). Locally an emulator (moto) on host port 5050.
# In AWS: real bucket, no endpoint URL, credentials from the ECS task role.
# Credentials are NOT read from this file: compose sets fake ones (test/test)
# inside the containers. Never put real AWS credentials here.
S3_BUCKET=tesis-files
S3_KEY_PREFIX=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:5050
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Server processes and database connections. Connections per task =
# WEB_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW): 2 * (3 + 2) = 10.
WEB_CONCURRENCY=2
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
